# Copy this file to .env and fill in the values. Write values bare, without quotes.
# If a value contains #, $ or quotes, export it from your shell instead and delete its line here.

# --- Required ---------------------------------------------------------------------------

# Your IOMETE console address, e.g. https://iomete.example.com
IOMETE_BASE_URL=

# An admin account. The suite creates its own access token from it.
IOMETE_ADMIN_USERNAME=admin
IOMETE_ADMIN_PASSWORD=

# Or use an existing admin access token instead of the password.
# IOMETE_TOKEN=your-access-token

# --- Optional ---------------------------------------------------------------------------

# Registry to pull Spark images from, if you use a mirror. Default: the public IOMETE registry.
# IOMETE_IMAGE_REGISTRY=registry.example.com/iomete

# Spark image to test: a tag of spark-py (e.g. 3.5.7-latest) or a full image reference.
# IOMETE_SPARK_IMAGE=3.5.7-latest

# Path to a custom SSL certificate (PEM format) for Spark Connect connections. Use this when
# your IOMETE target uses a self-signed or custom CA certificate. The certificate is added to
# the trust store so Spark Connect can connect over TLS. See the Python quickstart example:
# https://github.com/iomete/spark-connect-quickstart/blob/main/example_custom_cert.py
# IOMETE_SPARK_CONNECT_CERT=/path/to/ca-cert-chain.crt

# Also run the tests that change platform-wide state: a setting overridden and restored, a
# marketplace app and a Docker registry created and deleted, and a Model Gateway provider model
# that stays, since it cannot be deleted. Default: those tests skip.
# IOMETE_ALLOW_PLATFORM_CHANGES=false

# Fail, rather than skip, the schema parity checks that need the shared schema server's newer
# Spark image, when that server does not have them. Set it once your schema server runs that image.
# IOMETE_REQUIRE_SCHEMA_SERVER_FIXES=false

# An existing domain to run in; the run fails if it does not exist, and it is never deleted.
# Default: a new domain for each run, deleted by `make cleanup` (IOMETE 4.0.2+), or a shared
# `karate` domain on older versions.
# IOMETE_DOMAIN=your-test-domain

# Where computes and jobs run when you have several data planes: local (default), external or mixed.
# IOMETE_DATA_PLANE_STRATEGY=local

# LDAP sync test. Skipped unless these are set. See the README before enabling it.
# IOMETE_LDAP_URL=ldap://ldap.example.com:389
# IOMETE_LDAP_BIND_PASSWORD=your-bind-password

# Git integration test. Skipped unless these are set.
# IOMETE_GIT_REPO_URL=https://gitlab.example.com/your-group/your-project
# IOMETE_GIT_TOKEN=glpat-your-token

# Vault config test. Skipped unless all four are set: a Vault the platform can reach, a read-only
# token, and the KV v2 API path and key of one secret stored there.
# IOMETE_VAULT_ADDRESS=http://vault.example.com:8200
# IOMETE_VAULT_TOKEN=your-read-only-vault-token
# IOMETE_VAULT_SECRET_PATH=/v1/secret/data/your/path
# IOMETE_VAULT_SECRET_KEY=your-key

# The GitHub repository scenarios skip without these. Point them at a GitHub repository with at least
# one file at its root and a token that can read its contents.
# IOMETE_GITHUB_REPO_URL=https://github.com/your-org/your-test-repo
# IOMETE_GITHUB_TOKEN=github_pat_your-token

# Notification delivery. Skipped unless all five are set: an SMTP sink the platform can send to
# (plain SMTP, no login) and the sink's read API (a Mailpit). The job scenario also needs the
# platform's email integration to point at the sink. Where there is none, it saves one only if
# IOMETE_MAIL_SET_INTEGRATION=true, and leaves it in place: that changes the platform's email
# setup, so only set it on a disposable install.
# IOMETE_MAIL_SMTP_HOST=smtp-sink.example.com
# IOMETE_MAIL_SMTP_PORT=1025
# IOMETE_MAIL_SINK_URL=https://mail-sink.example.com
# IOMETE_MAIL_SINK_USERNAME=your-sink-user
# IOMETE_MAIL_SINK_PASSWORD=your-sink-password
# IOMETE_MAIL_SET_INTEGRATION=false
# Webhook delivery. Skipped unless all three are set: a webhook sink the platform can post to over
# https, and the sink's read API.
# Setting the flag below to true turns on and leaves on webhookNotifications; disposable installs only.
# IOMETE_WEBHOOK_SINK_URL=https://webhook-sink.example.com
# IOMETE_WEBHOOK_SINK_USERNAME=your-sink-user
# IOMETE_WEBHOOK_SINK_PASSWORD=your-sink-password
# IOMETE_WEBHOOK_SET_FLAG=false
# Optional real Slack and Teams webhooks the same scenario also posts to.
# IOMETE_WEBHOOK_SLACK_URL=https://hooks.slack.com/services/...
# A Teams Workflows URL ("Post to a channel when a webhook request is received"); classic Incoming Webhooks are refused.
# IOMETE_WEBHOOK_TEAMS_URL=https://...logic.azure.com/workflows/...
# Role grants on resource groups and namespaces only count with the resourceGroupRoles rollout flag on.
# Setting this to true turns it on and leaves it on; disposable installs only.
# With it off and this unset, the role-grant scenarios skip.
# IOMETE_RESOURCE_GROUP_ROLES_SET_FLAG=false
# Private domains can only be created with the privateDomains rollout flag on.
# Setting this to true turns it on and leaves it on; disposable installs only.
# With it off and this unset, the private-domain scenarios skip.
# IOMETE_PRIVATE_DOMAINS_SET_FLAG=false
# Storage connection check. Skipped unless all four are set: an S3-compatible endpoint the
# platform can reach, a bucket there, and an access key pair for it.
# The check is allowed only for a domain owner, so the run also makes its user an owner of the
# suite's domain.
# IOMETE_STORAGE_ENDPOINT=http://s3.example.com:9000
# IOMETE_STORAGE_BUCKET=your-test-bucket
# IOMETE_STORAGE_ACCESS_KEY=your-access-key
# IOMETE_STORAGE_SECRET_KEY=your-secret-key
